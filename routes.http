@API_URL = https://video-management-api-nslz.onrender.com
@VIDEO_ID = COLOQUE_O_ID_AQUI

###

POST {{API_URL}}/videos
Content-Type: application/json

{
    "title": "video 01",
    "description": "Esse é o primeiro vídeo",
    "duration": 180
}

###

GET {{API_URL}}/videos

###

PUT {{API_URL}}/videos/{{VIDEO_ID}}
Content-Type: application/json

{
    "title": "video teste",
    "description": "Esse é o primeiro vídeo",
    "duration": 180
}

###

DELETE {{API_URL}}/videos/{{VIDEO_ID}}